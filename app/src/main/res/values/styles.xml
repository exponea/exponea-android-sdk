<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorPrimaryDark</item>
        <item name="android:colorBackground">@color/colorPrimaryDark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="colorControlNormal">@color/colorAccent</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="materialButtonStyle">@style/AppButton</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout.FilledBox</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="MyDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorPrimaryDark</item>
        <item name="android:colorBackground">@color/colorPrimaryDark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="colorControlNormal">@color/colorAccent</item>
        <item name="colorControlActivated">@color/colorAccent</item>
    </style>

    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
    </style>

    <style name="AppButtonRed" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/red</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.TextInputLayout.FilledBox.ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="boxBackgroundColor">@color/colorPrimaryDark</item>
        <item name="boxStrokeColor">@color/filled_stroke_color</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout.FilledBox.ExposedDropdownMenu</item>
    </style>

    <style name="ThemeOverlay.App.TextInputLayout.FilledBox.ExposedDropdownMenu" parent="">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.MaterialComponents.AutoCompleteTextView.FilledBox</item>
    </style>

    <style name="Widget.App.TextInputLayout.FilledBox" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="boxBackgroundColor">@color/colorPrimaryDark</item>
        <item name="boxStrokeColor">@color/filled_stroke_color</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout.FilledBox</item>
    </style>

    <style name="ThemeOverlay.App.TextInputLayout.FilledBox" parent="">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="editTextStyle">@style/Widget.MaterialComponents.TextInputLayout.FilledBox</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.TextButton.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.Button.TextButton.Dialog</item>
    </style>

    <style name="Widget.App.Button.TextButton.Dialog" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Button.TextButton.Dialog</item>
    </style>

    <style name="ThemeOverlay.App.Button.TextButton.Dialog" parent="">
        <item name="colorPrimary">@color/white</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <style name="AppInboxButton" parent="@style/Widget.AppCompat.Button">
        <item name="android:theme">@style/AppButton</item>
    </style>

    <style name="AppInboxActionButton" parent="@style/Widget.AppCompat.Button">
        <item name="android:theme">@style/AppButton</item>
    </style>

    <style name="Theme.AppInboxListActivity" parent="@style/AppTheme">
    </style>

    <style name="Theme.AppInboxDetailActivity" parent="@style/AppTheme">
    </style>

    <style name="AppInboxEmptyStatusTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing" tools:targetApi="lollipop">0.01</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppInboxErrorStatusTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing" tools:targetApi="lollipop">0.01</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppInboxEmptyStatusMessage">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing" tools:targetApi="lollipop">0.02</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppInboxErrorStatusMessage">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing" tools:targetApi="lollipop">0.02</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppInboxAppBarOverlayStyle" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:theme">@style/Theme.AppInboxAppBarOverlay</item>
        <item name="android:background">@drawable/toolbar_gradient</item>
        <item name="elevation">0dp</item>
        <item name="android:translationZ">0.1dp</item>
    </style>

    <style name="AppInboxAppBarPopupStyle">
        <item name="android:theme">@style/Theme.AppInboxAppBarPopupOverlay</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.AppInboxAppBarPopupOverlay" parent="ThemeOverlay.AppCompat.Light" >
        <item name="colorPrimary">@android:color/transparent</item>
    </style>

</resources>
